NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=choose-a-strong-local-database-password
DATABASE_URL=postgresql://boilerplate:choose-a-strong-local-database-password@localhost:5432/boilerplate?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=profile-images
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
LOG_LEVEL=info
DOCS_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!ChangeMe
